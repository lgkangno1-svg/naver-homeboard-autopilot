# Naver
NAVER_ID=
NAVER_PW=
NAVER_BLOG_ID=issuemans

# Recommended primary LLM: OpenCode Go
# Writer and reviewer intentionally use different preferred models for cross-checking.
# If a preferred Go model is temporarily unavailable, llm.py automatically tries the fallback pool.
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=kimi-k3
OPENCODE_GO_REVIEW_MODEL=deepseek-v4-flash
OPENCODE_GO_VISION_MODEL=deepseek-v4-flash-vision-exp
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_FALLBACK_MODELS=deepseek-v4-pro,mimo-v2.5-pro,mimo-v2.5,kimi-k2.7-code
OPENCODE_GO_REVIEW_FALLBACK_MODELS=deepseek-v4-pro,mimo-v2.5-pro,mimo-v2.5,kimi-k2.7-code
OPENCODE_GO_SEND_TEMPERATURE=0
OPENCODE_GO_MAX_OUTPUT=6000

# Optional fallbacks outside OpenCode Go
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/ox-alpha
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5

# Image source
PIXABAY_KEY=

# Mini-PC/headless cron
HEADLESS=1
BROWSER_CHANNEL=chromium

OPENROUTER_MODEL=stealth/ox-alpha
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Image source
PIXABAY_KEY=

# Mini-PC/headless cron
HEADLESS=1
BROWSER_CHANNEL=chromium
